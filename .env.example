# Environment Configuration for SignalBlocks MVP

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=debug

# NATS JetStream Configuration
NATS_URL=nats://nats:4222
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_WAIT_MS=250
NATS_REQUEST_TIMEOUT_MS=5000

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONN_POOL=100
REDIS_IDLE_TIMEOUT_SEC=300

# MinIO S3-Compatible Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_DATA=signalblocks-data
MINIO_PARTITION_LAYOUT=year/month/day/group

# MinIO Root User (for initial setup)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# HTTP Server Configuration
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SEC=30
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_SHUTDOWN_TIMEOUT_SEC=10

# Monitoring UI Configuration
MONITORING_UI_PORT=8081
MONITORING_UI_REFRESH_INTERVAL_MS=5000

# Prometheus Metrics Configuration
PROMETHEUS_PORT=9091
PROMETHEUS_ENABLED=false
METRICS_RETENTION_HOURS=24

# Processing Configuration
INGEST_WORKERS=4
PROCESSING_WORKERS=4
INGEST_BATCH_SIZE=1000
INGEST_BATCH_TIMEOUT_MS=100
PROCESSING_BATCH_SIZE=10000
PROCESSING_BATCH_TIMEOUT_MS=500

# Session Builder Configuration
SESSION_BUILDER_ENABLED=true
SESSION_CHANGE_CHECK_INTERVAL_MS=1000
SESSION_FLUSH_INTERVAL_MS=5000

# Parquet Configuration
PARQUET_PAGE_SIZE=1048576
PARQUET_ROW_GROUP_SIZE=131072
PARQUET_COMPRESSION=SNAPPY
PARQUET_WRITE_TIMEOUT_SEC=60

# Tag Configuration
TAG_CACHE_TTL_SEC=3600
TAG_MAX_CACHE_SIZE=100000
TAG_METADATA_UPDATE_INTERVAL_MS=5000

# Logging Configuration
ZEROLOG_LEVEL=debug
LOKI_ENABLED=false
LOKI_URL=http://loki:3100
LOKI_BATCH_SIZE=100
LOKI_BATCH_TIMEOUT_MS=1000

# Grafana Configuration
GRAFANA_PASSWORD=admin
GRAFANA_PROVISIONING_ENABLED=true

# Database SLA Targets
QUERY_LATENCY_TARGET_MS=2
INGEST_THROUGHPUT_TARGET_MSGS_SEC=100000

# Feature Flags
FEATURE_MULTI_NODE_READY=false
FEATURE_DUCKDB_QUERY_ENGINE=true
FEATURE_REDIS_LIVE_INDEX=true
FEATURE_SESSION_TRACKING=true

# Debug & Development
DEBUG_MODE=false
DEBUG_TRACE_INGEST=false
DEBUG_TRACE_PROCESSING=false
DEBUG_TRACE_STORAGE=false
MOCK_MQTT_PUBLISHER=false
MOCK_DATA_RATE_HZ=100
